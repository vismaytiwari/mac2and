# Copy this file to .env for local development.
# Keep .env private; it is ignored by git and is not bundled into the app.

# Required for creating the public tunnel through the ngrok CLI.
NGROK_AUTHTOKEN=

# Initial password for the Android page and API calls. It is reachable over the
# public ngrok URL, so use a long, random value (e.g. `openssl rand -base64 24`).
# It also derives the clipboard encryption key. If left empty, the app generates
# a strong random token instead (but then the page cannot be reached remotely).
# You can change it later from the menu bar ("Change Password…"); the new value
# is stored in the macOS Keychain and takes precedence over this.
APP_PASSWORD=

# Optional reserved ngrok domain, for example: example.ngrok-free.app
NGROK_DOMAIN=

# Optional path to ngrok if it is not on PATH.
NGROK_BIN=

# Optional. Leave empty or set 0 to let macOS choose a free local port.
SERVER_PORT=0
