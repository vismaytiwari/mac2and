# Copy this file to .env for local development.
# Keep .env private; it is ignored by git and is not bundled into the app.

# Required for creating the public tunnel through the ngrok CLI.
NGROK_AUTHTOKEN=

# Required password for the Android page and API calls.
APP_PASSWORD=

# Optional reserved ngrok domain, for example: example.ngrok-free.app
NGROK_DOMAIN=

# Optional path to ngrok if it is not on PATH.
NGROK_BIN=

# Optional. Leave empty or set 0 to let macOS choose a free local port.
SERVER_PORT=0
